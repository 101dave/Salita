# Required by the existing PostgreSQL workspace
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional preferred live translation provider (for example, a self-hosted LibreTranslate)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional MyMemory credentials used when LibreTranslate is not configured or available
MYMEMORY_API_KEY=
MYMEMORY_EMAIL=
